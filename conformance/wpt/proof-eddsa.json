    },
    {
      "id": "wrong-typ",
      "description": "validly signed, but the JOSE `typ` is `jwt` and not `wpt+jwt`",
      "expect": "wrong_type",
      "proof": "eyJ0eXAiOiJqd3QiLCJhbGciOiJFZERTQSJ9..4rR5IbAcXGzmTDLj8VrVRXeF-VQZvQERSBkUtr_U79r_BA9w5tU6jKURdi7gtiK_Wi9cseZV253wvvLCAfzODA"
    },
    {
      "id": "tampered-payload",
      "description": "`jti` was altered after signing; the payload is still valid JSON",
      "expect": "invalid_signature",
      "proof": "eyJ0eXAiOiJ3cHQrand0IiwiYWxnIjoiRWREU0EifQ..NS_rWn6aB09yRqboGc06oVgXm5uQdULu_bwafvOC8RS5EJufoEuxmtRErTE1ZniZRg5WHx8kd40pCrsLkJEDDQ"
    },
    {
      "id": "txn-token-mismatch",
      "description": "replayed against a request carrying a different Txn-Token",
      "expect": "txn_token_binding_mismatch",
      "txn_token": "txn-token-fedcba9876543210"
    },
    {
      "id": "txn-token-absent",
      "description": "`tth` is present but the request carries no Txn-Token",
      "expect": "txn_token_binding_mismatch",
      "no_txn_token": true
    },
    {
      "id": "context-token-mismatch",
      "description": "replayed against a request carrying a different context token",
      "expect": "other_token_binding_mismatch",
      "other_tokens": {
        "ctx-token": "ctx-token-fedcba9876543210"
      }
    },
    {
      "id": "context-token-absent",
      "description": "`oth` names a header the request does not carry, so the entry cannot be understood and the proof must be rejected",
      "expect": "other_token_binding_mismatch",
      "other_tokens": {}
    }
  ]
}
